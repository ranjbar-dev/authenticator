# Vendored upstream notices are verified against their exact recorded bytes.
# Windows checkout line-ending conversion must not rewrite those public inputs.
assets/notices/** -text

# Package inputs and embedded text use the same bytes in Windows checkouts.
Cargo.lock text eol=lf
assets/windows.manifest text eol=lf
assets/fonts/OFL.txt text eol=lf
LICENSE-MIT text eol=lf
LICENSE-APACHE text eol=lf
docs/package-readme.md text eol=lf
docs/user-guide.md text eol=lf
docs/security-limits.md text eol=lf

# Preserve exact bytes of the explicitly retained, reviewed public QA logs.
# This does not unignore runtime logs or add target/ciphertext artifacts.
docs/qa/task24/follow-up/final-check-*.log -text
docs/qa/task24/state-gaps/release-build.log -text
docs/qa/task24/state-gaps/*/build.log -text
docs/qa/task23/clean-build-109171a.log -text
docs/qa/task23/repro-full-*.log -text
