<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Authenticator.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///Styles/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--  Brand purple drives every accent-colored control (buttons, toggles, focus, selection).  -->
            <Color x:Key="SystemAccentColor">#8B5CF6</Color>
            <Color x:Key="SystemAccentColorLight1">#9F7AEA</Color>
            <Color x:Key="SystemAccentColorLight2">#A78BFA</Color>
            <Color x:Key="SystemAccentColorLight3">#C4B5FD</Color>
            <Color x:Key="SystemAccentColorDark1">#7C3AED</Color>
            <Color x:Key="SystemAccentColorDark2">#6D28D9</Color>
            <Color x:Key="SystemAccentColorDark3">#5B21B6</Color>
        </ResourceDictionary>
    </Application.Resources>
</Application>
