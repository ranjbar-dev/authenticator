<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Authenticator.App.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Authenticator.App.Views"
    xmlns:vm="using:Authenticator.App.ViewModels"
    AllowDrop="True"
    CharacterReceived="OnCharacterReceived"
    DragOver="OnDragOver"
    Drop="OnDrop"
    FontFamily="{StaticResource AppFontFamily}">

    <Page.Resources>
        <!--  Rows draw their own hover; suppress the ListViewItem overlay so it doesn't double up.  -->
        <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="Transparent" />

        <DataTemplate x:Key="AccountTemplate" x:DataType="vm:AccountItemViewModel">
            <Grid
                AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}"
                Background="{ThemeResource TileBrush}"
                CornerRadius="12"
                Loaded="OnRowLoaded"
                PointerCanceled="OnRowPointerExited"
                PointerCaptureLost="OnRowPointerReleased"
                PointerEntered="OnRowPointerEntered"
                PointerExited="OnRowPointerExited"
                PointerPressed="OnRowPointerPressed"
                PointerReleased="OnRowPointerReleased">
                <Grid.ContextFlyout>
                    <MenuFlyout Opening="OnContextFlyoutOpening">
                        <MenuFlyoutItem Click="OnCopyMenuClick" Text="Copy code">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE8C8;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Click="OnPinMenuClick" Text="{x:Bind local:MainPage.PinLabel(IsPinned), Mode=OneWay}">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE718;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Click="OnEditMenuClick" Text="Edit details">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE70F;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Click="OnShowQrMenuClick" Text="Show QR code">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xED14;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Click="OnDeleteMenuClick" Text="Delete">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE74D;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Grid.ContextFlyout>

                <!--  Hover surface fades in over the resting tile.  -->
                <Border
                    Background="{ThemeResource TileHoverBrush}"
                    CornerRadius="12"
                    Opacity="{x:Bind local:MainPage.HoverOpacity(IsHovered), Mode=OneWay}">
                    <Border.OpacityTransition>
                        <ScalarTransition Duration="0:0:0.15" />
                    </Border.OpacityTransition>
                </Border>

                <Grid Padding="14,12,16,12" ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!--  Squircle monogram  -->
                    <Border
                        Width="40"
                        Height="40"
                        VerticalAlignment="Center"
                        Background="{ThemeResource AvatarBackgroundBrush}"
                        CornerRadius="11">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource AvatarForegroundBrush}"
                            Text="{x:Bind Initial, Mode=OneWay}" />
                    </Border>

                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Spacing="1">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock
                                FontSize="14.5"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource InkBrush}"
                                MaxLines="1"
                                Text="{x:Bind Title, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                            <FontIcon
                                VerticalAlignment="Center"
                                FontSize="10"
                                Foreground="{ThemeResource AccentTextBrush}"
                                Glyph="&#xE840;"
                                Visibility="{x:Bind IsPinned, Mode=OneWay}" />
                        </StackPanel>
                        <TextBlock
                            Style="{StaticResource SecondaryTextStyle}"
                            Text="{x:Bind Subtitle, Mode=OneWay}"
                            Visibility="{x:Bind local:MainPage.VisibleIfText(Subtitle), Mode=OneWay}" />
                    </StackPanel>

                    <StackPanel
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Spacing="1">
                        <!--  The code. Ink at rest, accent on hover, warning when about to change.  -->
                        <Grid HorizontalAlignment="Right">
                            <TextBlock
                                Style="{StaticResource CodeTextStyle}"
                                Text="{x:Bind Code, Mode=OneWay}"
                                Visibility="{x:Bind local:MainPage.CodeLayer(IsHovered, IsExpiring, HasVisibleCode, 0), Mode=OneWay}" />
                            <TextBlock
                                Foreground="{ThemeResource AccentTextBrush}"
                                Style="{StaticResource CodeTextStyle}"
                                Text="{x:Bind Code, Mode=OneWay}"
                                Visibility="{x:Bind local:MainPage.CodeLayer(IsHovered, IsExpiring, HasVisibleCode, 1), Mode=OneWay}" />
                            <TextBlock
                                Foreground="{ThemeResource WarningBrush}"
                                Style="{StaticResource CodeTextStyle}"
                                Text="{x:Bind Code, Mode=OneWay}"
                                Visibility="{x:Bind local:MainPage.CodeLayer(IsHovered, IsExpiring, HasVisibleCode, 2), Mode=OneWay}" />
                            <!--  Counter-based, hidden until asked for.  -->
                            <TextBlock
                                Foreground="{ThemeResource TertiaryTextBrush}"
                                Style="{StaticResource CodeTextStyle}"
                                Text="{x:Bind Code, Mode=OneWay}"
                                Visibility="{x:Bind local:MainPage.CodeLayer(IsHovered, IsExpiring, HasVisibleCode, 3), Mode=OneWay}" />
                        </Grid>

                        <Grid
                            Height="16"
                            HorizontalAlignment="Right">
                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="5"
                                Visibility="{x:Bind JustCopied, Mode=OneWay}">
                                <FontIcon
                                    FontSize="11"
                                    Foreground="{ThemeResource AccentTextBrush}"
                                    Glyph="&#xE73E;" />
                                <TextBlock
                                    FontSize="12"
                                    FontWeight="Medium"
                                    Foreground="{ThemeResource AccentTextBrush}"
                                    Text="Copied" />
                            </StackPanel>
                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="6"
                                Visibility="{x:Bind local:MainPage.Not(JustCopied), Mode=OneWay}">
                                <ProgressRing
                                    Width="12"
                                    Height="12"
                                    MinWidth="12"
                                    MinHeight="12"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource TrackBrush}"
                                    IsIndeterminate="False"
                                    Maximum="{x:Bind Period}"
                                    Visibility="{x:Bind HasCustomPeriod}"
                                    Value="{x:Bind Remaining, Mode=OneWay}" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource SecondaryTextBrush}"
                                    Text="{x:Bind Caption, Mode=OneWay}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Grid>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="AccountPanel">
            <ItemsWrapGrid Orientation="Horizontal" SizeChanged="OnWrapGridSizeChanged" />
        </ItemsPanelTemplate>

        <TransitionCollection x:Key="RowTransitions">
            <EntranceThemeTransition FromVerticalOffset="18" IsStaggeringEnabled="True" />
            <AddDeleteThemeTransition />
            <ReorderThemeTransition />
        </TransitionCollection>

        <Style x:Key="StepNumberStyle" TargetType="Border">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Background" Value="{ThemeResource AvatarBackgroundBrush}" />
        </Style>
    </Page.Resources>

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator
            Invoked="OnPasteAccelerator"
            Key="V"
            Modifiers="Control" />
        <KeyboardAccelerator
            Invoked="OnAddManualAccelerator"
            Key="N"
            Modifiers="Control" />
        <KeyboardAccelerator
            Invoked="OnOpenImageAccelerator"
            Key="O"
            Modifiers="Control" />
        <KeyboardAccelerator
            Invoked="OnSearchAccelerator"
            Key="F"
            Modifiers="Control" />
        <KeyboardAccelerator
            Invoked="OnLockAccelerator"
            Key="L"
            Modifiers="Control" />
    </Page.KeyboardAccelerators>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Header: left-aligned display title with live status, actions on the right.  -->
        <Grid Padding="22,2,14,0" ColumnSpacing="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Spacing="2">
                <TextBlock Style="{StaticResource DisplayTextStyle}" Text="Codes" />
                <TextBlock
                    x:Name="StatusText"
                    Style="{StaticResource SecondaryTextStyle}" />
            </StackPanel>
            <DropDownButton
                x:Name="AddButton"
                Grid.Column="1"
                Height="36"
                Margin="0,0,6,0"
                Padding="12,0,10,0"
                VerticalAlignment="Center"
                AutomationProperties.Name="Add account"
                Style="{StaticResource AccentButtonStyle}"
                ToolTipService.ToolTip="Add account">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon FontSize="13" Glyph="&#xE710;" />
                    <TextBlock FontWeight="Medium" Text="Add" />
                </StackPanel>
                <DropDownButton.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                        <MenuFlyoutItem
                            x:Name="ScanMenuItem"
                            Click="OnScanClick"
                            Text="Scan QR code from screen">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xF407;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem
                            Click="OnPasteClick"
                            KeyboardAcceleratorTextOverride="Ctrl+V"
                            Text="Paste image">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE77F;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem
                            Click="OnOpenImageClick"
                            KeyboardAcceleratorTextOverride="Ctrl+O"
                            Text="Open image…">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xEB9F;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem
                            Click="OnAddManualClick"
                            KeyboardAcceleratorTextOverride="Ctrl+N"
                            Text="Enter setup key">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE765;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </DropDownButton.Flyout>
            </DropDownButton>
            <Button
                Grid.Column="2"
                VerticalAlignment="Center"
                AutomationProperties.Name="Lock"
                Click="OnLockClick"
                Style="{StaticResource IconButtonStyle}"
                ToolTipService.ToolTip="Lock (Ctrl+L)">
                <FontIcon FontSize="16" Glyph="&#xE72E;" />
            </Button>
            <Button
                Grid.Column="3"
                VerticalAlignment="Center"
                AutomationProperties.Name="Settings"
                Click="OnSettingsClick"
                Style="{StaticResource IconButtonStyle}"
                ToolTipService.ToolTip="Settings (Ctrl+,)">
                <FontIcon FontSize="16" Glyph="&#xE713;" />
            </Button>
        </Grid>

        <!--  Shared time strip for every 30-second code, plus search.  -->
        <StackPanel
            Grid.Row="1"
            Margin="22,12,22,0"
            Spacing="12"
            Visibility="{x:Bind ViewModel.HasAccounts, Mode=OneWay}">
            <Grid
                x:Name="TimeStrip"
                Height="3"
                AutomationProperties.AccessibilityView="Raw"
                Visibility="{x:Bind ViewModel.HasStandardTotp, Mode=OneWay}">
                <Border Background="{ThemeResource TrackBrush}" CornerRadius="1.5" />
                <Border
                    x:Name="StripFill"
                    Background="{ThemeResource RingBrush}"
                    CornerRadius="1.5" />
                <Border
                    x:Name="StripWarning"
                    Background="{ThemeResource WarningBrush}"
                    CornerRadius="1.5"
                    Visibility="Collapsed" />
            </Grid>
            <AutoSuggestBox
                x:Name="SearchBox"
                AutomationProperties.Name="Search accounts"
                PlaceholderText="Search"
                QueryIcon="Find"
                Text="{x:Bind ViewModel.SearchText, Mode=TwoWay}" />
        </StackPanel>

        <!--  Notices  -->
        <StackPanel
            Grid.Row="2"
            Margin="19,10,19,0"
            Spacing="6">
            <InfoBar
                x:Name="UpdateBar"
                Title="Update ready"
                CloseButtonClick="OnUpdateBarClosed"
                IsClosable="True"
                Severity="Success">
                <InfoBar.ActionButton>
                    <Button Click="OnRestartToUpdateClick" Content="Restart now" />
                </InfoBar.ActionButton>
            </InfoBar>
            <InfoBar
                x:Name="BatchBar"
                Title="More codes to scan"
                IsClosable="True"
                Severity="Informational">
                <InfoBar.ActionButton>
                    <Button Click="OnScanClick" Content="Scan next" />
                </InfoBar.ActionButton>
            </InfoBar>
            <InfoBar
                x:Name="NoticeBar"
                IsClosable="True" />
            <InfoBar
                x:Name="ClockBar"
                Title="Your clock may be wrong"
                IsClosable="True"
                Severity="Warning" />
            <InfoBar
                x:Name="BackupBar"
                Title="No backup yet"
                CloseButtonClick="OnBackupReminderClosed"
                IsClosable="True"
                Message="Keep an encrypted copy in case this PC is lost."
                Severity="Informational">
                <InfoBar.ActionButton>
                    <Button Click="OnBackupNowClick" Content="Back up now" />
                </InfoBar.ActionButton>
            </InfoBar>
        </StackPanel>

        <!--  Account lists  -->
        <ScrollViewer
            x:Name="ListScroller"
            Grid.Row="3"
            Padding="19,0,19,20"
            VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock
                    Style="{StaticResource SectionHeaderStyle}"
                    Text="Pinned"
                    Visibility="{x:Bind ViewModel.HasPinned, Mode=OneWay}" />
                <ListView
                    x:Name="PinnedList"
                    AllowDrop="{x:Bind ViewModel.CanReorder, Mode=OneWay}"
                    CanDragItems="{x:Bind ViewModel.CanReorder, Mode=OneWay}"
                    CanReorderItems="{x:Bind ViewModel.CanReorder, Mode=OneWay}"
                    DragItemsCompleted="OnDragItemsCompleted"
                    IsItemClickEnabled="True"
                    ItemClick="OnItemClick"
                    ItemContainerStyle="{StaticResource AccountItemContainerStyle}"
                    ItemContainerTransitions="{StaticResource RowTransitions}"
                    ItemTemplate="{StaticResource AccountTemplate}"
                    ItemsPanel="{StaticResource AccountPanel}"
                    ItemsSource="{x:Bind ViewModel.Pinned}"
                    SelectionMode="None" />
                <TextBlock
                    Style="{StaticResource SectionHeaderStyle}"
                    Text="Everything else"
                    Visibility="{x:Bind ViewModel.HasPinned, Mode=OneWay}" />
                <ListView
                    x:Name="OthersList"
                    Margin="0,3,0,0"
                    AllowDrop="{x:Bind ViewModel.CanReorder, Mode=OneWay}"
                    CanDragItems="{x:Bind ViewModel.CanReorder, Mode=OneWay}"
                    CanReorderItems="{x:Bind ViewModel.CanReorder, Mode=OneWay}"
                    DragItemsCompleted="OnDragItemsCompleted"
                    IsItemClickEnabled="True"
                    ItemClick="OnItemClick"
                    ItemContainerStyle="{StaticResource AccountItemContainerStyle}"
                    ItemContainerTransitions="{StaticResource RowTransitions}"
                    ItemTemplate="{StaticResource AccountTemplate}"
                    ItemsPanel="{StaticResource AccountPanel}"
                    ItemsSource="{x:Bind ViewModel.Others}"
                    SelectionMode="None" />

                <!--  Search: no results  -->
                <StackPanel
                    Margin="3,36,3,0"
                    Spacing="4"
                    Visibility="{x:Bind ViewModel.NoResults, Mode=OneWay}">
                    <TextBlock Style="{StaticResource TitleTextStyle}" Text="No matches" />
                    <TextBlock Style="{StaticResource LeadTextStyle}" Text="Try the service name or the email address on the account." />
                </StackPanel>

                <!--  Empty state: a short, concrete getting-started path.  -->
                <StackPanel
                    MaxWidth="400"
                    Margin="3,22,3,0"
                    HorizontalAlignment="Left"
                    Spacing="18"
                    Visibility="{x:Bind local:MainPage.Not(ViewModel.HasAccounts), Mode=OneWay}">
                    <StackPanel.ChildrenTransitions>
                        <TransitionCollection>
                            <EntranceThemeTransition FromVerticalOffset="16" IsStaggeringEnabled="True" />
                        </TransitionCollection>
                    </StackPanel.ChildrenTransitions>

                    <StackPanel Spacing="6">
                        <TextBlock Style="{StaticResource TitleTextStyle}" Text="Add your first account" />
                        <TextBlock Style="{StaticResource LeadTextStyle}" Text="Bring codes over from your phone or a website's 2FA setup. It takes a few seconds." />
                    </StackPanel>

                    <Grid ColumnSpacing="14" RowSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Style="{StaticResource StepNumberStyle}">
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{ThemeResource AvatarForegroundBrush}" Text="1" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock FontWeight="SemiBold" Foreground="{ThemeResource InkBrush}" Text="Put the QR code on screen" />
                            <TextBlock FontSize="13" Style="{StaticResource LeadTextStyle}" Text="A website's 2FA setup page, or Google Authenticator → Transfer accounts (via Phone Link or a screenshot)." />
                        </StackPanel>

                        <Border Grid.Row="1" Style="{StaticResource StepNumberStyle}">
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{ThemeResource AvatarForegroundBrush}" Text="2" />
                        </Border>
                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="2">
                            <TextBlock FontWeight="SemiBold" Foreground="{ThemeResource InkBrush}">
                                <Run Text="Press " /><Run x:Name="HotkeyRun" FontFamily="{StaticResource CodeFontFamily}" Foreground="{ThemeResource AccentTextBrush}" Text="Ctrl + Shift + Q" />
                            </TextBlock>
                            <TextBlock FontSize="13" Style="{StaticResource LeadTextStyle}" Text="Works from any app while Authenticator is running." />
                        </StackPanel>

                        <Border Grid.Row="2" Style="{StaticResource StepNumberStyle}">
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{ThemeResource AvatarForegroundBrush}" Text="3" />
                        </Border>
                        <StackPanel Grid.Row="2" Grid.Column="1" Spacing="2">
                            <TextBlock FontWeight="SemiBold" Foreground="{ThemeResource InkBrush}" Text="Drag around the code" />
                            <TextBlock FontSize="13" Style="{StaticResource LeadTextStyle}" Text="Or click once to scan everything on screen. You'll review accounts before they're saved." />
                        </StackPanel>
                    </Grid>

                    <StackPanel Spacing="6">
                        <Button
                            Height="40"
                            HorizontalAlignment="Stretch"
                            AutomationProperties.Name="Scan from screen"
                            Click="OnScanClick"
                            Style="{StaticResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="15" Glyph="&#xF407;" />
                                <TextBlock FontWeight="Medium" Text="Scan from screen" />
                            </StackPanel>
                        </Button>
                        <StackPanel Margin="-11,0,0,0" Orientation="Horizontal">
                            <HyperlinkButton Click="OnPasteClick" Content="Paste image" />
                            <HyperlinkButton Click="OnOpenImageClick" Content="Open image" />
                            <HyperlinkButton Click="OnAddManualClick" Content="Enter setup key" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!--  Ink toast for list-level results (single-row copies confirm inline instead).  -->
        <Border
            x:Name="Toast"
            Grid.Row="3"
            Margin="0,0,0,22"
            Padding="16,10"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            AutomationProperties.AccessibilityView="Raw"
            Background="{ThemeResource InkBrush}"
            CornerRadius="10"
            IsHitTestVisible="False"
            Opacity="0">
            <Border.OpacityTransition>
                <ScalarTransition Duration="0:0:0.18" />
            </Border.OpacityTransition>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon
                    FontSize="13"
                    Foreground="{ThemeResource OnInkBrush}"
                    Glyph="&#xE73E;" />
                <TextBlock
                    x:Name="ToastText"
                    FontWeight="Medium"
                    Foreground="{ThemeResource OnInkBrush}" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
