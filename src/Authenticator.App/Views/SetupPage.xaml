<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Authenticator.App.Views.SetupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Authenticator.App.Controls"
    FontFamily="{StaticResource AppFontFamily}">

    <Grid>
        <controls:AmbientGlow />
        <ScrollViewer SizeChanged="OnViewportSizeChanged" VerticalScrollBarVisibility="Auto">
            <StackPanel
                x:Name="Column"
                Width="356"
                Margin="0,28,0,40"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="14">
                <StackPanel.ChildrenTransitions>
                    <TransitionCollection>
                        <EntranceThemeTransition FromVerticalOffset="16" IsStaggeringEnabled="True" />
                    </TransitionCollection>
                </StackPanel.ChildrenTransitions>

                <Image
                    Width="52"
                    Height="52"
                    HorizontalAlignment="Left"
                    AutomationProperties.AccessibilityView="Raw"
                    Source="ms-appx:///Assets/AppIcon-256.png" />
                <TextBlock
                    Margin="0,6,0,0"
                    Style="{StaticResource DisplayTextStyle}"
                    Text="Your codes, locked to this PC." />
                <TextBlock
                    x:Name="IntroText"
                    Style="{StaticResource LeadTextStyle}"
                    Text="Accounts are encrypted before they're saved. Choose how you'll unlock them." />

                <!--  Option: Windows Hello  -->
                <Button
                    x:Name="HelloButton"
                    Margin="0,10,0,0"
                    AutomationProperties.Name="Use Windows Hello (recommended)"
                    Click="OnSetUpHelloClick"
                    Style="{StaticResource OptionTileStyle}"
                    Visibility="Collapsed">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Width="40"
                            Height="40"
                            Background="{ThemeResource AvatarBackgroundBrush}"
                            CornerRadius="10">
                            <FontIcon
                                FontSize="20"
                                Foreground="{ThemeResource AvatarForegroundBrush}"
                                Glyph="&#xE928;" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock FontWeight="SemiBold" Text="Windows Hello" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    FontWeight="Medium"
                                    Foreground="{ThemeResource AccentTextBrush}"
                                    Text="Recommended" />
                            </StackPanel>
                            <TextBlock
                                Style="{StaticResource SecondaryTextStyle}"
                                Text="Face, fingerprint or PIN"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <FontIcon
                            x:Name="HelloChevron"
                            Grid.Column="2"
                            FontSize="12"
                            Foreground="{ThemeResource TertiaryTextBrush}"
                            Glyph="&#xE76C;" />
                        <ProgressRing
                            x:Name="HelloBusy"
                            Grid.Column="2"
                            Width="18"
                            Height="18"
                            IsActive="False" />
                    </Grid>
                </Button>

                <!--  Option: App password  -->
                <Button
                    x:Name="PasswordOption"
                    AutomationProperties.Name="Use an app password"
                    Click="OnUsePasswordClick"
                    Style="{StaticResource OptionTileStyle}">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Width="40"
                            Height="40"
                            Background="{ThemeResource AvatarBackgroundBrush}"
                            CornerRadius="10">
                            <FontIcon
                                FontSize="18"
                                Foreground="{ThemeResource AvatarForegroundBrush}"
                                Glyph="&#xE8D7;" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock FontWeight="SemiBold" Text="App password" />
                            <TextBlock
                                Style="{StaticResource SecondaryTextStyle}"
                                Text="A password only you know"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <FontIcon
                            x:Name="PasswordChevron"
                            Grid.Column="2"
                            FontSize="12"
                            Foreground="{ThemeResource TertiaryTextBrush}"
                            Glyph="&#xE70D;" />
                    </Grid>
                </Button>

                <!--  Password form (progressive disclosure)  -->
                <StackPanel
                    x:Name="PasswordPanel"
                    Margin="0,4,0,0"
                    Spacing="12"
                    Visibility="Collapsed">
                    <TextBlock
                        x:Name="NoHelloText"
                        Style="{StaticResource LeadTextStyle}"
                        Text="Windows Hello isn't set up on this PC, so you'll unlock with an app password."
                        Visibility="Collapsed" />
                    <PasswordBox
                        x:Name="NewPassword"
                        Header="App password"
                        PasswordChanged="OnPasswordChanged" />
                    <PasswordBox
                        x:Name="ConfirmPassword"
                        Header="Confirm password"
                        KeyDown="OnConfirmKeyDown"
                        PasswordChanged="OnPasswordChanged" />
                    <controls:PasswordChecklist x:Name="Checklist" />
                    <TextBlock
                        Style="{StaticResource SecondaryTextStyle}"
                        Text="It can't be recovered if you forget it. You can make a backup file later in Settings."
                        TextTrimming="None"
                        TextWrapping="Wrap" />
                    <Button
                        x:Name="CreateButton"
                    AutomationProperties.Name="Create encrypted vault"
                        Height="38"
                        Margin="0,4,0,0"
                        HorizontalAlignment="Stretch"
                        Click="OnCreateWithPasswordClick"
                        IsEnabled="False"
                        Style="{StaticResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ProgressRing
                                x:Name="CreateBusy"
                                Width="14"
                                Height="14"
                                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                IsActive="False"
                                Visibility="Collapsed" />
                            <TextBlock Text="Create encrypted vault" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <InfoBar
                    x:Name="ErrorBar"
                    IsClosable="True"
                    Severity="Error" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
