<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        One accent (purple), one tinted neutral family. Codes are ink, not accent: the accent marks
        what you can act on (hover, buttons, the time strip), so it stays meaningful.
    -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="InkBrush" Color="#1C1626" />
            <SolidColorBrush x:Key="OnInkBrush" Color="#F7F5FB" />
            <SolidColorBrush x:Key="SecondaryTextBrush" Color="#6B6478" />
            <SolidColorBrush x:Key="TertiaryTextBrush" Color="#9A93A8" />
            <SolidColorBrush x:Key="AccentTextBrush" Color="#6D28D9" />
            <SolidColorBrush x:Key="AvatarBackgroundBrush" Color="#EDE9FE" />
            <SolidColorBrush x:Key="AvatarForegroundBrush" Color="#5B21B6" />
            <SolidColorBrush x:Key="CodeForegroundBrush" Color="#1C1626" />
            <SolidColorBrush x:Key="TileBrush" Color="#FFFFFF" Opacity="0.72" />
            <SolidColorBrush x:Key="TileHoverBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="TileStrokeBrush" Color="#5B21B6" Opacity="0.07" />
            <SolidColorBrush x:Key="TrackBrush" Color="#5B21B6" Opacity="0.10" />
            <SolidColorBrush x:Key="RingBrush" Color="#7C3AED" />
            <SolidColorBrush x:Key="RingTrackBrush" Color="#EDE9FE" />
            <SolidColorBrush x:Key="WarningBrush" Color="#C2410C" />
            <SolidColorBrush x:Key="SuccessBrush" Color="#15803D" />
            <SolidColorBrush x:Key="DangerBrush" Color="#DC2626" />
            <Color x:Key="GlowColor">#337C3AED</Color>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="InkBrush" Color="#F3F0F7" />
            <SolidColorBrush x:Key="OnInkBrush" Color="#16121C" />
            <SolidColorBrush x:Key="SecondaryTextBrush" Color="#A59EB2" />
            <SolidColorBrush x:Key="TertiaryTextBrush" Color="#7A7387" />
            <SolidColorBrush x:Key="AccentTextBrush" Color="#C4B5FD" />
            <SolidColorBrush x:Key="AvatarBackgroundBrush" Color="#2A1B4E" />
            <SolidColorBrush x:Key="AvatarForegroundBrush" Color="#DDD6FE" />
            <SolidColorBrush x:Key="CodeForegroundBrush" Color="#F3F0F7" />
            <SolidColorBrush x:Key="TileBrush" Color="#231E2B" Opacity="0.66" />
            <SolidColorBrush x:Key="TileHoverBrush" Color="#2A2439" />
            <SolidColorBrush x:Key="TileStrokeBrush" Color="#FFFFFF" Opacity="0.05" />
            <SolidColorBrush x:Key="TrackBrush" Color="#C4B5FD" Opacity="0.12" />
            <SolidColorBrush x:Key="RingBrush" Color="#A78BFA" />
            <SolidColorBrush x:Key="RingTrackBrush" Color="#2A1B4E" />
            <SolidColorBrush x:Key="WarningBrush" Color="#FBBF24" />
            <SolidColorBrush x:Key="SuccessBrush" Color="#4ADE80" />
            <SolidColorBrush x:Key="DangerBrush" Color="#F87171" />
            <Color x:Key="GlowColor">#408B5CF6</Color>
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="InkBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="OnInkBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SecondaryTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="TertiaryTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="AccentTextBrush" Color="{ThemeResource SystemColorHotlightColor}" />
            <SolidColorBrush x:Key="AvatarBackgroundBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="AvatarForegroundBrush" Color="{ThemeResource SystemColorButtonTextColor}" />
            <SolidColorBrush x:Key="CodeForegroundBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="TileBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="TileHoverBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="TileStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="TrackBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
            <SolidColorBrush x:Key="RingBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="RingTrackBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="WarningBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="SuccessBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="DangerBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <Color x:Key="GlowColor">#00000000</Color>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!--  Geist wherever controls render text; Geist Mono for codes and keys.  -->
    <FontFamily x:Key="ContentControlThemeFontFamily">ms-appx:///Assets/Fonts/Geist.ttf#Geist</FontFamily>
    <FontFamily x:Key="AppFontFamily">ms-appx:///Assets/Fonts/Geist.ttf#Geist</FontFamily>
    <FontFamily x:Key="CodeFontFamily">ms-appx:///Assets/Fonts/GeistMono.ttf#Geist Mono</FontFamily>

    <!--  Softer geometry: controls 6, containers and dialogs 12.  -->
    <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">12</CornerRadius>

    <!--  Type scale  -->
    <Style x:Key="DisplayTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="-30" />
        <Setter Property="LineHeight" Value="34" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{ThemeResource InkBrush}" />
    </Style>

    <Style x:Key="TitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="-15" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{ThemeResource InkBrush}" />
    </Style>

    <Style x:Key="LeadTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="LineHeight" Value="21" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{ThemeResource SecondaryTextBrush}" />
    </Style>

    <Style x:Key="SecondaryTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{ThemeResource SecondaryTextBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!--  Sentence-case label with a little positive tracking; no shouty all-caps.  -->
    <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="CharacterSpacing" Value="30" />
        <Setter Property="Margin" Value="4,18,0,8" />
        <Setter Property="Foreground" Value="{ThemeResource SecondaryTextBrush}" />
    </Style>

    <Style x:Key="CodeTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource CodeFontFamily}" />
        <Setter Property="FontSize" Value="25" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="CharacterSpacing" Value="20" />
        <Setter Property="Foreground" Value="{ThemeResource CodeForegroundBrush}" />
    </Style>

    <Style x:Key="PageTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource DisplayTextStyle}" />

    <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <!--  Large selectable option used on the setup screen.  -->
    <Style x:Key="OptionTileStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="16,14" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Background" Value="{ThemeResource TileBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource TileStrokeBrush}" />
    </Style>

    <Style x:Key="AccountItemContainerStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="3" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="CornerRadius" Value="12" />
    </Style>
</ResourceDictionary>
