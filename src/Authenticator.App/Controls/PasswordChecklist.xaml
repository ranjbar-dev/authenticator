<?xml version="1.0" encoding="utf-8"?>
<!--  Segmented strength meter plus live requirement checks for "choose a password" forms.  -->
<UserControl
    x:Class="Authenticator.App.Controls.PasswordChecklist"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="TrackStyle" TargetType="Border">
            <Setter Property="Height" Value="4" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Background" Value="{ThemeResource TrackBrush}" />
        </Style>
        <Style x:Key="FillStyle" TargetType="Border">
            <Setter Property="Height" Value="4" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Background" Value="{ThemeResource RingBrush}" />
            <Setter Property="Opacity" Value="0" />
        </Style>
    </UserControl.Resources>

    <StackPanel Spacing="10">
        <Grid ColumnSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="84" />
            </Grid.ColumnDefinitions>
            <Grid VerticalAlignment="Center">
                <Border Style="{StaticResource TrackStyle}" />
                <Border x:Name="Fill0" Style="{StaticResource FillStyle}">
                    <Border.OpacityTransition>
                        <ScalarTransition />
                    </Border.OpacityTransition>
                </Border>
            </Grid>
            <Grid Grid.Column="1" VerticalAlignment="Center">
                <Border Style="{StaticResource TrackStyle}" />
                <Border x:Name="Fill1" Style="{StaticResource FillStyle}">
                    <Border.OpacityTransition>
                        <ScalarTransition />
                    </Border.OpacityTransition>
                </Border>
            </Grid>
            <Grid Grid.Column="2" VerticalAlignment="Center">
                <Border Style="{StaticResource TrackStyle}" />
                <Border x:Name="Fill2" Style="{StaticResource FillStyle}">
                    <Border.OpacityTransition>
                        <ScalarTransition />
                    </Border.OpacityTransition>
                </Border>
            </Grid>
            <Grid Grid.Column="3" VerticalAlignment="Center">
                <Border Style="{StaticResource TrackStyle}" />
                <Border x:Name="Fill3" Style="{StaticResource FillStyle}">
                    <Border.OpacityTransition>
                        <ScalarTransition />
                    </Border.OpacityTransition>
                </Border>
            </Grid>
            <TextBlock
                x:Name="StrengthLabel"
                Grid.Column="4"
                HorizontalAlignment="Right"
                Style="{StaticResource SecondaryTextStyle}"
                Text="Strength" />
        </Grid>

        <StackPanel Spacing="4">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Grid Width="14">
                    <FontIcon
                        x:Name="LengthMet"
                        FontSize="12"
                        Foreground="{ThemeResource SuccessBrush}"
                        Glyph="&#xE73E;"
                        Visibility="Collapsed" />
                    <FontIcon
                        x:Name="LengthUnmet"
                        FontSize="12"
                        Foreground="{ThemeResource TertiaryTextBrush}"
                        Glyph="&#xEA3A;" />
                </Grid>
                <TextBlock
                    x:Name="LengthText"
                    Style="{StaticResource SecondaryTextStyle}"
                    Text="At least 8 characters" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Grid Width="14">
                    <FontIcon
                        x:Name="MatchMet"
                        FontSize="12"
                        Foreground="{ThemeResource SuccessBrush}"
                        Glyph="&#xE73E;"
                        Visibility="Collapsed" />
                    <FontIcon
                        x:Name="MatchUnmet"
                        FontSize="12"
                        Foreground="{ThemeResource TertiaryTextBrush}"
                        Glyph="&#xEA3A;" />
                </Grid>
                <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Both passwords match" />
            </StackPanel>
        </StackPanel>
    </StackPanel>
</UserControl>
