<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Authenticator.App.Dialogs.ImportReviewDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Authenticator.App.ViewModels"
    Title="Review accounts"
    CloseButtonText="Cancel"
    DefaultButton="Primary">

    <ContentDialog.Resources>
        <DataTemplate x:Key="CandidateTemplate" x:DataType="vm:ImportCandidate">
            <Grid Padding="0,10" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <CheckBox
                    MinWidth="0"
                    Margin="0,4,0,0"
                    VerticalAlignment="Top"
                    AutomationProperties.Name="{x:Bind Title, Mode=OneWay}"
                    IsChecked="{x:Bind Include, Mode=TwoWay}" />
                <Border
                    Grid.Column="1"
                    Width="36"
                    Height="36"
                    VerticalAlignment="Top"
                    Background="{ThemeResource AvatarBackgroundBrush}"
                    CornerRadius="10">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource AvatarForegroundBrush}"
                        Text="{x:Bind Initial}" />
                </Border>
                <StackPanel Grid.Column="2" Spacing="4">
                    <TextBox
                        AutomationProperties.Name="Service"
                        PlaceholderText="Service"
                        Text="{x:Bind Issuer, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox
                        AutomationProperties.Name="Account name"
                        PlaceholderText="Account name"
                        Text="{x:Bind Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind Details}" />
                        <Border
                            Padding="6,1"
                            Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                            CornerRadius="4"
                            Visibility="{x:Bind IsDuplicate}">
                            <TextBlock
                                FontSize="11"
                                Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                Text="Already added" />
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </ContentDialog.Resources>

    <Grid MinWidth="340" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock
            x:Name="SummaryText"
            Style="{StaticResource LeadTextStyle}" />
        <InfoBar
            x:Name="WarningsBar"
            Grid.Row="1"
            IsClosable="False"
            Severity="Warning" />
        <ListView
            x:Name="CandidateList"
            Grid.Row="2"
            MaxHeight="380"
            ItemTemplate="{StaticResource CandidateTemplate}"
            SelectionMode="None" />
    </Grid>
</ContentDialog>
